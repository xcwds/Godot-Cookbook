{
	"name": "Godot Cookbook",
	"build": {
		"dockerfile": "Dockerfile",
		// The repository root, so the image can read .godot-version.
		"context": ".."
	},
	// Imports every project once so the language server and smoke runs work straight away.
	"postCreateCommand": "tools/check.sh import",
	"customizations": {
		"vscode": {
			"extensions": [
				"geequlim.godot-tools",
				"EditorConfig.EditorConfig"
			],
			"settings": {
				"godotTools.editorPath.godot4": "/usr/local/bin/godot",
				"godotTools.lsp.headless": true,
				"godotTools.inlayHints.gdscript": true,
				"editor.insertSpaces": false,
				"editor.detectIndentation": false
			}
		}
	}
}
