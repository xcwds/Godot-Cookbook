[gd_scene format=3]

[ext_resource type="Script" path="res://recipes/scene_transition/demo_room.gd" id="script"]

[node name="Demo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")
other_room = "res://recipes/scene_transition/demo_room_b.tscn"

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.15, 0.3, 0.5, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Room A"
horizontal_alignment = 1

[node name="Quick" type="Button" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "Go to the other room"

[node name="Slow" type="Button" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "Go, pretending it takes 2 seconds to load"
