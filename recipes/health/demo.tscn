[gd_scene format=3]

[ext_resource type="Script" path="res://recipes/health/demo.gd" id="script"]
[ext_resource type="Script" path="res://recipes/health/health.gd" id="health"]

[node name="Demo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")

[node name="Health" type="Node" parent="."]
script = ExtResource("health")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Status" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Center/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Damage" type="Button" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Damage 3"

[node name="Heal" type="Button" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Heal 2"

[node name="Reset" type="Button" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Reset"

[node name="Log" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
