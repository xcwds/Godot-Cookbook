[gd_scene format=3]

[ext_resource type="Script" path="res://recipes/meter/demo.gd" id="script"]
[ext_resource type="Script" path="res://recipes/meter/meter.gd" id="meter"]
[ext_resource type="PackedScene" path="res://recipes/health_bar/health_bar_2d.tscn" id="bar"]

[node name="Demo" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")

[node name="Stamina" type="Node" parent="."]
script = ExtResource("meter")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Status" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1

[node name="Bar" parent="Center/Layout" node_paths=PackedStringArray("meter") instance=ExtResource("bar")]
layout_mode = 2
size_flags_horizontal = 4
meter = NodePath("../../../Stamina")

[node name="Buttons" type="HBoxContainer" parent="Center/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Spend" type="Button" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Spend 4 (all or nothing)"

[node name="Drain" type="Button" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Drain 3"

[node name="Add" type="Button" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Add 2"

[node name="Fill" type="Button" parent="Center/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Fill"

[node name="Log" type="Label" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
text = "The bar is the health_bar recipe showing a plain Meter."
