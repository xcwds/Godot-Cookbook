[gd_scene format=3]

[ext_resource type="Script" path="res://recipes/inventory/inventory_panel.gd" id="script"]

[node name="InventoryPanel" type="PanelContainer"]
custom_minimum_size = Vector2(180, 0)
offset_right = 180.0
offset_bottom = 80.0
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Inventory"

[node name="Empty" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.5)
text = "Empty"

[node name="ItemList" type="VBoxContainer" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
