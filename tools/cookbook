#!/usr/bin/env python3
"""Copy cookbook recipes into another Godot project.

    tools/cookbook list
    tools/cookbook info third_person_movement
    tools/cookbook add third_person_movement --to ~/games/my_game
    tools/cookbook status --to ~/games/my_game

`add` copies the recipe and the recipes it depends on, adds the input
actions and physics layer names they need to the target's project.godot
(without changing ones that exist), and prints what is left to do by hand.
It stops if the project already has a script with the same `class_name` as
one in the recipes. Each copied folder gets a `.cookbook` file recording the
cookbook commit it came from; `status` reads those and says which copies are
behind the cookbook or have been edited.

Needs only Python 3. Run it from a clone of the cookbook.
"""

import argparse
import datetime
import hashlib
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RECIPES_DIR = ROOT / "recipes"
DEFAULT_DEST = "addons/cookbook"
# Text files in which res://recipes/ paths are rewritten to the new location.
TEXT_SUFFIXES = {".tscn", ".tres", ".gd", ".gdshader", ".cfg", ".import", ".md"}
# Written into each copied recipe folder. Godot ignores files that start with a dot.
STAMP_NAME = ".cookbook"
# Files Godot writes or rewrites by itself, which are not a user's edits.
GENERATED_SUFFIXES = {".import", ".uid"}
CLASS_NAME = re.compile(r"^class_name\s+(\w+)", flags=re.M)


class CookbookError(Exception):
    pass


def read_text(path):
    """Reads a text file as UTF-8, leaving its line endings as they are."""
    with open(path, encoding="utf-8", newline="") as file:
        return file.read()


def write_text(path, text):
    """Writes UTF-8 without translating line endings, on every platform."""
    with open(path, "w", encoding="utf-8", newline="") as file:
        file.write(text)


def line_ending(text):
    """The line ending a file uses, judged by its first line break."""
    match = re.search(r"\r?\n", text)
    return match.group(0) if match else "\n"


def to_lf(text):
    """The text with CRLF line endings turned into LF, for parsing."""
    return text.replace("\r\n", "\n")


def from_lf(text, ending):
    """LF text converted back to the given line ending."""
    return text if ending == "\n" else text.replace("\n", ending)


# --- recipes -----------------------------------------------------------------


def read_manifest(name):
    """Reads recipes/<name>/recipe.cfg. Its values are JSON-compatible."""
    path = RECIPES_DIR / name / "recipe.cfg"
    if not path.is_file():
        raise CookbookError(f"no recipe named '{name}' (try: tools/cookbook list)")
    manifest = {}
    for line in read_text(path).splitlines():
        match = re.match(r"^(\w+)=(.*)$", line)
        if not match:
            continue
        try:
            manifest[match.group(1)] = json.loads(match.group(2))
        except json.JSONDecodeError as error:
            raise CookbookError(f"{path}: cannot read '{line}': {error}") from error
    manifest.setdefault("name", name)
    manifest.setdefault("description", "")
    manifest.setdefault("depends", [])
    manifest.setdefault("input_actions", [])
    manifest.setdefault("physics_layers_3d", {})
    manifest.setdefault("project_settings", {})
    manifest.setdefault("godot", "")
    return manifest


def recipe_names():
    return sorted(p.parent.name for p in RECIPES_DIR.glob("*/recipe.cfg"))


def with_dependencies(names):
    """The given recipes plus everything they depend on, dependencies first."""
    ordered = []

    def visit(name, trail):
        if name in trail:
            raise CookbookError("dependency cycle: " + " -> ".join(trail + [name]))
        for dependency in read_manifest(name)["depends"]:
            visit(dependency, trail + [name])
        if name not in ordered:
            ordered.append(name)

    for name in names:
        visit(name, [])
    return ordered


def recipe_files(name):
    """Files to copy for a recipe: everything except its demo."""
    base = RECIPES_DIR / name
    return sorted(
        path.relative_to(base)
        for path in base.rglob("*")
        if path.is_file() and not path.name.startswith("demo")
    )


def class_names(path):
    """The global class a script registers, as a list (empty if none)."""
    try:
        return CLASS_NAME.findall(read_text(path))
    except (OSError, UnicodeDecodeError):
        return []


def recipe_classes(name):
    """Maps each global class name a recipe defines to its file in the recipe."""
    classes = {}
    for relative in recipe_files(name):
        if relative.suffix == ".gd":
            for class_name in class_names(RECIPES_DIR / name / relative):
                classes[class_name] = relative
    return classes


# --- provenance ---------------------------------------------------------------


def file_hash(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def source_hash(name):
    """One hash over the files `add` would copy for a recipe, as they are now."""
    digest = hashlib.sha256()
    for relative in recipe_files(name):
        digest.update(relative.as_posix().encode() + b"\0")
        digest.update((RECIPES_DIR / name / relative).read_bytes() + b"\0")
    return digest.hexdigest()


def cookbook_commit(name):
    """The cookbook's commit, "-modified" if the recipe has uncommitted changes."""

    def git(*arguments):
        result = subprocess.run(
            ["git", "-C", str(ROOT), *arguments], capture_output=True, text=True, check=False
        )
        return result.stdout.strip() if result.returncode == 0 else None

    try:
        top = git("rev-parse", "--show-toplevel")
        if top is None or Path(top).resolve() != ROOT:
            return "unknown"
        commit = git("rev-parse", "HEAD")
        if commit is None:
            return "unknown"
        if git("status", "--porcelain", "--", f"recipes/{name}"):
            commit += "-modified"
        return commit
    except OSError:  # git is not installed
        return "unknown"


def copied_files(folder):
    """Maps each file in a copied recipe folder to its hash, without the stamp."""
    return {
        path.relative_to(folder).as_posix(): file_hash(path)
        for path in sorted(folder.rglob("*"))
        if path.is_file() and path.name != STAMP_NAME
    }


def write_stamp(name, folder):
    stamp = {
        "recipe": name,
        "commit": cookbook_commit(name),
        "date": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d"),
        "source": source_hash(name),
        "files": copied_files(folder),
    }
    write_text(folder / STAMP_NAME, json.dumps(stamp, indent=1) + "\n")


def read_stamp(folder):
    """The stamp of a copied recipe, or None if it has none that can be read."""
    try:
        stamp = json.loads(read_text(folder / STAMP_NAME))
    except (OSError, ValueError):
        return None
    if not isinstance(stamp, dict) or not isinstance(stamp.get("files"), dict):
        return None
    return stamp


def local_edits(folder, stamp):
    """What differs between a copied recipe and its stamp, as "word file" lines.

    Files that Godot generates or rewrites (.import, .uid) do not count.
    """
    now = copied_files(folder)
    edits = []
    for relative, recorded in stamp["files"].items():
        if Path(relative).suffix == ".import":
            continue
        if relative not in now:
            edits.append(f"deleted  {relative}")
        elif now[relative] != recorded:
            edits.append(f"changed  {relative}")
    for relative in now:
        if relative not in stamp["files"] and Path(relative).suffix not in GENERATED_SUFFIXES:
            edits.append(f"added    {relative}")
    return edits


# --- project.godot -----------------------------------------------------------


def split_sections(text):
    """Splits project.godot into (header, [(section_name, body), ...]).

    Expects LF line endings; convert with to_lf() first.
    """
    parts = re.split(r"^\[([^\]\n]+)\]\n", text, flags=re.M)
    sections = [(parts[i], parts[i + 1]) for i in range(1, len(parts), 2)]
    return parts[0], sections


def join_sections(header, sections):
    text = header
    for name, body in sections:
        text += f"[{name}]\n{body}"
    return text


def section_entries(body):
    """Maps each key in a section to its full text (values can span lines)."""
    entries = {}
    key = None
    for line in body.splitlines(keepends=True):
        match = re.match(r"^([\w/.\-]+)=", line)
        if match:
            key = match.group(1)
            entries[key] = line
        elif key is not None and line.strip():
            entries[key] += line
    return entries


def add_entries(text, section, new_entries):
    """Adds entries to a section, creating it if needed. Existing keys win."""
    header, sections = split_sections(text)
    for index, (name, body) in enumerate(sections):
        if name == section:
            existing = section_entries(body)
            missing = [v for k, v in new_entries.items() if k not in existing]
            if missing:
                body = body.rstrip("\n") + "\n" + "".join(missing) + "\n"
                if not body.startswith("\n"):
                    body = "\n" + body
                sections[index] = (name, body)
            return join_sections(header, sections)
    if not new_entries:
        return text
    body = "\n" + "".join(new_entries.values()) + "\n"
    if not text.endswith("\n\n"):
        text = text.rstrip("\n") + "\n\n"
    return text + f"[{section}]\n{body}"


def godot_minor(project_text):
    match = re.search(r'config/features=PackedStringArray\(([^)]*)\)', project_text)
    if not match:
        return None
    version = re.search(r'"(\d+)\.(\d+)"', match.group(1))
    return (int(version.group(1)), int(version.group(2))) if version else None


# --- commands ----------------------------------------------------------------


def command_list(_args):
    names = recipe_names()
    width = max(len(name) for name in names)
    for name in names:
        print(f"{name.ljust(width)}  {read_manifest(name)['description']}")


def command_info(args):
    manifest = read_manifest(args.recipe)
    everything = with_dependencies([args.recipe])
    actions, layers = requirements(everything)
    print(f"{manifest['name']} ({args.recipe})")
    print(f"  {manifest['description']}")
    print(f"  Godot:           {manifest['godot'] or 'any'}")
    print(f"  Depends on:      {', '.join(everything[:-1]) or 'nothing'}")
    print(f"  Input actions:   {', '.join(actions) or 'none'}")
    layer_text = ", ".join(f"{number} ({name})" for name, number in layers.items())
    print(f"  Physics layers:  {layer_text or 'none'}")
    settings = recommended_settings(everything)
    setting_text = ", ".join(f"{key}={format_setting(value)}" for key, value in settings.items())
    print(f"  Recommended:     {setting_text or 'no project settings'}")
    print(f"  Class names:     {', '.join(sorted(recipe_classes(args.recipe))) or 'none'}")
    print(f"  Files:           {len(recipe_files(args.recipe))}, see recipes/{args.recipe}/")
    print(f"  Read more:       recipes/{args.recipe}/README.md")


def requirements(names):
    """Input actions and physics layers needed by a set of recipes."""
    actions, layers = [], {}
    for name in names:
        manifest = read_manifest(name)
        for action in manifest["input_actions"]:
            if action not in actions:
                actions.append(action)
        layers.update(manifest["physics_layers_3d"])
    return actions, layers


def recommended_settings(names):
    """Project settings the recipes work best with. They are never changed."""
    settings = {}
    for name in names:
        settings.update(read_manifest(name)["project_settings"])
    return settings


def format_setting(value):
    """A value as project.godot writes it."""
    return json.dumps(value)


def has_setting(project_text, key, value):
    """True if project.godot already sets section/key to the value."""
    section, _, name = key.partition("/")
    entries = section_entries(dict(split_sections(project_text)[1]).get(section, ""))
    return entries.get(name, "").strip() == f"{name}={format_setting(value)}"


def command_add(args):
    target = Path(args.to).expanduser().resolve()
    project_file = target / "project.godot"
    if not project_file.is_file():
        raise CookbookError(f"{target} is not a Godot project (no project.godot)")
    if target == ROOT:
        raise CookbookError("the target is the cookbook itself")
    dest = args.dest.strip("/")
    names = with_dependencies(args.recipes)
    # project.godot is parsed and edited with LF endings and written back with
    # the ending it had, so a CRLF file (a Windows checkout) stays CRLF.
    original_text = read_text(project_file)
    ending = line_ending(original_text)
    project_text = to_lf(original_text)
    say = print if not args.dry_run else lambda text: print("(dry run) " + text)

    # 1. Copy the recipes. Everything that could stop the copy is checked
    # first, so a refusal leaves the project as it was.
    to_copy = [n for n in names if args.force or not (target / dest / n).exists()]
    clashes = class_clashes(to_copy, target, dest)
    if clashes and not args.force:
        raise CookbookError(
            "the project already defines class names these recipes use:\n"
            + "\n".join(f"  {clash}" for clash in clashes)
            + "\nGodot allows one script per class_name. Rename yours, or pass --force to "
            "copy anyway and sort it out in the editor."
        )
    for name in to_copy:
        recipe_dest = target / dest / name
        stamp = read_stamp(recipe_dest) if recipe_dest.is_dir() else None
        edits = local_edits(recipe_dest, stamp) if stamp else []
        if edits and not args.discard_edits:
            raise CookbookError(
                f"{dest}/{name} has been edited since it was copied:\n"
                + "\n".join(f"  {edit}" for edit in edits)
                + "\n--force would delete these edits. Add --discard-edits to replace it anyway."
            )

    for name in names:
        recipe_dest = target / dest / name
        if name not in to_copy:
            say(f"skip   {dest}/{name} (already there; --force to overwrite)")
            continue
        if recipe_dest.exists():
            say(f"delete {dest}/{name} ({len(copied_files(recipe_dest))} files, to replace it)")
        say(f"copy   {name} -> {dest}/{name}")
        if args.dry_run:
            continue
        if recipe_dest.exists():
            shutil.rmtree(recipe_dest)
        for relative in recipe_files(name):
            copy_file(RECIPES_DIR / name / relative, recipe_dest / relative, dest)
        write_stamp(name, recipe_dest)

    # 2. Input actions and layer names the recipes need.
    actions, layers = requirements(names)
    cookbook_text = to_lf(read_text(ROOT / "project.godot"))
    cookbook_inputs = dict(split_sections(cookbook_text)[1]).get("input", "")
    available = section_entries(cookbook_inputs)
    target_inputs = section_entries(dict(split_sections(project_text)[1]).get("input", ""))
    new_actions = {a: available[a] for a in actions if a not in target_inputs and a in available}
    for action in actions:
        if action in target_inputs:
            say(f"keep   input action '{action}' (already defined)")
        elif action in available:
            say(f"add    input action '{action}'")
    project_text = add_entries(project_text, "input", new_actions)

    target_layers = section_entries(dict(split_sections(project_text)[1]).get("layer_names", ""))
    new_layers, notes = {}, []
    for layer_name, number in layers.items():
        key = f"3d_physics/layer_{number}"
        if key not in target_layers:
            say(f"add    physics layer {number} name '{layer_name}'")
            new_layers[key] = f'{key}="{layer_name}"\n'
        elif f'"{layer_name}"' not in target_layers[key]:
            current = target_layers[key].split("=", 1)[1].strip()
            notes.append(
                f"Physics layer {number} is already named {current}; the recipes use it "
                f"as '{layer_name}'. Change the layers on the copied scenes if that clashes."
            )
    project_text = add_entries(project_text, "layer_names", new_layers)

    if not args.dry_run and project_text != to_lf(original_text):
        write_text(project_file, from_lf(project_text, ending))

    # 3. What is left for a person.
    target_version = godot_minor(project_text)
    for name in names:
        wanted = read_manifest(name)["godot"]
        if wanted and target_version and tuple(map(int, wanted.split("."))) > target_version:
            notes.append(
                f"'{name}' was written for Godot {wanted}; this project is on "
                f"{target_version[0]}.{target_version[1]}."
            )
    for key, value in recommended_settings(names).items():
        if not has_setting(project_text, key, value):
            notes.append(
                f"Recommended project setting: {key} = {format_setting(value)} "
                "(Project Settings, with Advanced Settings on). It is not changed for you; "
                "the recipe READMEs say what it is for."
            )
    for clash in clashes:
        notes.append(f"Class name clash, copied because of --force: {clash}")
    missing = [a for a in actions if a not in target_inputs and a not in available]
    if missing:
        notes.append("Define these input actions yourself: " + ", ".join(missing))
    notes.append("Open the project in Godot once so it imports the new files.")
    for name in args.recipes:
        notes.append(f"Setup steps for '{name}': {dest}/{name}/README.md")
    print("\nNext:")
    for note in notes:
        print(f"  - {note}")


def class_clashes(names, target, dest):
    """Describes each global class the recipes define that the project has too.

    The folders the recipes are copied into are not searched: what is there is
    skipped or replaced.
    """
    wanted = {}
    for name in names:
        for class_name, relative in recipe_classes(name).items():
            wanted[class_name] = f"recipes/{name}/{relative.as_posix()}"
    if not wanted:
        return []
    replaced = [target / dest / name for name in names]
    clashes = []
    for path in sorted(target.rglob("*.gd")):
        if ".godot" in path.relative_to(target).parts:
            continue
        if any(folder in path.parents for folder in replaced):
            continue
        for class_name in class_names(path):
            if class_name in wanted:
                clashes.append(
                    f"{class_name}: {path.relative_to(target).as_posix()} in the project, "
                    f"{wanted[class_name]} in the cookbook"
                )
    return clashes


def command_status(args):
    target = Path(args.to).expanduser().resolve()
    if not (target / "project.godot").is_file():
        raise CookbookError(f"{target} is not a Godot project (no project.godot)")
    stamps = sorted(
        path
        for path in target.rglob(STAMP_NAME)
        if path.is_file() and ".godot" not in path.relative_to(target).parts
    )
    if not stamps:
        print("No recipes copied by tools/cookbook were found in this project.")
        print("(Copies made before it recorded where they came from are not listed.)")
        return
    available = recipe_names()
    for stamp_path in stamps:
        folder = stamp_path.parent
        where = folder.relative_to(target).as_posix()
        stamp = read_stamp(folder)
        if stamp is None:
            print(f"{where}: its {STAMP_NAME} file cannot be read")
            continue
        name = str(stamp.get("recipe", folder.name))
        commit, _, modified = str(stamp.get("commit", "unknown")).partition("-")
        if commit != "unknown":
            commit = commit[:10] + (" with uncommitted changes" if modified else "")
        print(
            f"{where}: {name}, copied {stamp.get('date', 'at an unknown date')} "
            f"from cookbook commit {commit}"
        )
        if name not in available:
            print("  the cookbook no longer has this recipe")
        elif stamp.get("source") != source_hash(name):
            print("  behind: the cookbook's version has changed since")
        else:
            print("  same as the cookbook's version")
        edits = local_edits(folder, stamp)
        if edits:
            print("  edited here:")
            for edit in edits:
                print(f"    {edit}")
        else:
            print("  not edited here")


def copy_file(source, destination, dest):
    destination.parent.mkdir(parents=True, exist_ok=True)
    if source.suffix not in TEXT_SUFFIXES:
        shutil.copyfile(source, destination)
        return
    text = read_text(source)
    text = text.replace("res://recipes/", f"res://{dest}/")
    if source.suffix == ".import":
        # These point into the cookbook's import cache; Godot regenerates them.
        text = re.sub(r"^(path|dest_files)=.*\n", "", text, flags=re.M)
    write_text(destination, text)


def main():
    parser = argparse.ArgumentParser(
        prog="tools/cookbook", description="Copy cookbook recipes into another Godot project."
    )
    commands = parser.add_subparsers(dest="command", required=True)

    commands.add_parser("list", help="list the recipes").set_defaults(run=command_list)

    info = commands.add_parser("info", help="show what a recipe needs")
    info.add_argument("recipe")
    info.set_defaults(run=command_info)

    add = commands.add_parser("add", help="copy recipes into a project")
    add.add_argument("recipes", nargs="+", metavar="recipe")
    add.add_argument("--to", required=True, metavar="PROJECT", help="folder with project.godot")
    add.add_argument(
        "--dest",
        default=DEFAULT_DEST,
        help=f"folder inside the project to copy into (default: {DEFAULT_DEST})",
    )
    add.add_argument(
        "--force",
        action="store_true",
        help="replace recipes already copied, and copy despite class name clashes",
    )
    add.add_argument(
        "--discard-edits",
        action="store_true",
        help="with --force, replace a copy even if it was edited after it was copied",
    )
    add.add_argument("--dry-run", action="store_true", help="show what would happen")
    add.set_defaults(run=command_add)

    status = commands.add_parser("status", help="list the recipes copied into a project")
    status.add_argument("--to", required=True, metavar="PROJECT", help="folder with project.godot")
    status.set_defaults(run=command_status)

    args = parser.parse_args()
    try:
        args.run(args)
    except CookbookError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
